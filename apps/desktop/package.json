{
  "name": "@wisp/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Wisp desktop — runs the studio natively and can host it for tablets on the same network.",
  "main": "dist/main.js",
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "start": "npm run build && electron .",
    "package": "npm run build && electron-builder --publish never"
  },
  "dependencies": {
    "@wisp/core": "*",
    "@wisp/ops": "*"
  },
  "devDependencies": {
    "@types/ws": "^8.18.1",
    "electron": "^33.4.11",
    "electron-builder": "^26.15.3",
    "electron-updater": "^6.8.9",
    "esbuild": "^0.25.0",
    "ws": "^8.21.3"
  }
}
